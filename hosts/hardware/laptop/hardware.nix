# yada yada yada. fuck you! edit this all u want
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.cfg.hosts.laptop;
in
{

  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "ahci"
    "usbhid"
    "usb_storage"
    "sd_mod"
    "rtsx_usb_sdmmc"
  ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.kernelParams = [

    # For some reason you cannot 'nixos-rebuild switch' without this...
    "systemd.gpt_auto=no"

    # disable password timeout for luks devices
    "luks.options=timeout=0"
    "rd.luks.options=timeout=0"

    # assume root device is already there
    # do not wait for it to appear
    "rootflags=x-systemd.device-timeout=0"

    # nvme speedup
    "nvme_core.default_ps_max_latency_us=0"
  ];

  fileSystems."/" = {
    device = "/dev/mapper/${cfg.rootMapperName}";
    fsType = "xfs";
  };

  boot.initrd.luks.devices.${cfg.rootMapperName} = {
    device = "/dev/disk/by-uuid/${cfg.rootLuksUuid}";
    preLVM = true;
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/${cfg.bootPartitionUuid}";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  fileSystems."/home" = {
    device = "/dev/mapper/${cfg.homeMapperName}";
    fsType = "xfs";
  };

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;

  # hostname
  networking.hostName = cfg.hostName;

  sops.secrets.homeLuksKey = {
    sopsFile = ../../../secrets/secrets.yaml;
    key = cfg.homeLuksKeySopsKey;
  };

  environment.etc."crypttab".text = ''
    ${cfg.homeMapperName} UUID=${cfg.homeLuksUuid} ${config.sops.secrets.homeLuksKey.path} luks,nofail
  '';

  hardware.graphics = {
    enable = true;
    enable32Bit = true;
  };

}
